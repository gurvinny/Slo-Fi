{
  "name": "slo-fi",
  "version": "3.0.0-beta.1",
  "description": "Professional-grade browser audio slow-down tool with convolution reverb",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.mjs && tsc && vite build && node scripts/precache-sw.mjs",
    "preview": "npm run build && wrangler dev",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "rm -rf .vitest-reports && vitest run --coverage --reporter=blob --outputFile=.vitest-reports/unit.json && vitest run --config vitest.dom.config.ts --coverage --reporter=blob --outputFile=.vitest-reports/dom.json && vitest --mergeReports=.vitest-reports --coverage",
    "test:verify": "node scripts/check-test-count.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.0",
    "@playwright/test": "^1.63.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.183.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.84.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.183.2"
  }
}
