{
  "name": "slo-fi",
  "version": "3.0.0-beta.1",
  "description": "Professional-grade browser audio slow-down tool with convolution reverb",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.mjs && tsc && vite build && node scripts/precache-sw.mjs",
    "preview": "npm run build && wrangler dev",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.0",
    "@playwright/test": "^1.63.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.183.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "wrangler": "^4.84.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "ogl": "^1.0.11",
    "tailwindcss": "^4.3.3",
    "three": "^0.183.2"
  }
}
